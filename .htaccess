Options -Indexes
Options -ExecCGI
ServerSignature Off

# ---- Force HTTPS (PRODUCTION ONLY — uncomment when live) ----
 <IfModule mod_rewrite.c>
    RewriteEngine On
     RewriteCond %{HTTPS} off
     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
 </IfModule>

# ============================================================
# CLEAN URL REWRITING
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ---- Skip real files and directories ----
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ---- Prevent PHP execution in uploads ----
    RewriteRule ^uploads/.*\.php$ - [F,L]

    # ---- PUBLIC PAGES ----
    RewriteRule ^$                       pages/index.php [L]
    RewriteRule ^shop/?$                 pages/shop.php [L]
    RewriteRule ^shop\?(.*)$             pages/shop.php?$1 [QSA,L]
    RewriteRule ^product/([^/]+)/?$      pages/product.php?slug=$1 [QSA,L]
    RewriteRule ^cart/?$                 pages/cart.php [QSA,L]
    RewriteRule ^checkout/?$             pages/checkout.php [L]
    RewriteRule ^order-confirm/?$        pages/order_confirm.php [QSA,L]
    RewriteRule ^orders/?$               pages/orders.php [L]
    RewriteRule ^installment/?$          pages/installment.php [L]
    RewriteRule ^about/?$                pages/about.php [L]
    RewriteRule ^contact/?$              pages/contact.php [L]
    RewriteRule ^store/?$                pages/store.php [L]
    RewriteRule ^profile/?$              pages/profile.php [L]

    # ---- AUTH ----
    RewriteRule ^login/?$                auth/login.php [QSA,L]
    RewriteRule ^register/?$             auth/register.php [L]
    RewriteRule ^logout/?$               auth/logout.php [L]

    # ---- ADMIN PAGES ----
    RewriteRule ^admin/?$                admin/index.php [L]
    RewriteRule ^admin/products/?$       admin/products.php [QSA,L]
    RewriteRule ^admin/orders/?$         admin/orders.php [QSA,L]
    RewriteRule ^admin/installments/?$   admin/installments.php [QSA,L]
    RewriteRule ^admin/customers/?$      admin/customers.php [L]
    RewriteRule ^admin/messages/?$       admin/messages.php [QSA,L]
    RewriteRule ^admin/profile/?$        admin/profile.php [QSA,L]

    # ---- PAYMENTS ----
    RewriteRule ^payments/pesapal_ipn/?$       payments/pesapal_ipn.php [QSA,L]
    RewriteRule ^payments/pesapal_callback/?$  payments/pesapal_callback.php [QSA,L]

    # ---- SITEMAP ----
    RewriteRule ^sitemap\.xml$           sitemap.php [L]
</IfModule>

# ---- Protect config directory (enable on production) ----
 <IfModule mod_rewrite.c>
     RewriteRule ^config/ - [F,L]
 </IfModule>

# ---- Security Headers ----
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---- Block common attack patterns (enable on production) ----
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{QUERY_STRING} (;|<|>|'|"|\)|%0A|%0D|%22|%27|%3C|%3E|%00) [NC]
#     RewriteRule .* - [F,L]
#     RewriteCond %{QUERY_STRING} (<script|javascript:|vbscript:|onload=|onerror=) [NC]
#     RewriteRule .* - [F,L]
# </IfModule>

<IfModule mod_evasive20.c>
    DOSHashTableSize 3097
    DOSPageCount 10
    DOSSiteCount 100
    DOSPageInterval 2
    DOSSiteInterval 1
    DOSBlockingPeriod 60
</IfModule>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(sql|log|env|sh|bak|config|ini|htpasswd)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

AddDefaultCharset UTF-8

<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_flag expose_php Off
    php_value session.cookie_httponly 1
    php_value session.cookie_secure 1
    php_value session.use_only_cookies 1
    php_value session.cookie_samesite Strict
</IfModule>
